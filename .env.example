# Copier vers .env puis remplacer TOUTES les valeurs "change-me". Ne jamais committer .env.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:28000
# Ports publiés sur 127.0.0.1 (modifiables si déjà pris sous Windows ; 8000 et 18000 sont déjà pris par d'autres projets sur le poste de développement)
API_PORT=28000
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=nurselearn
POSTGRES_USER=nurselearn
POSTGRES_PASSWORD=change-me
# 55432 plutôt que 5432 : évite les conflits avec un PostgreSQL local ou une plage
# de ports réservée par Windows (« access permissions » au démarrage, Phase 1.1).
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://nurselearn:change-me@localhost:55432/nurselearn

# Redis
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# Stockage S3 (RustFS en local, compatible S3)
S3_ENDPOINT=http://localhost:9000
# R3 : S3_ACCESS_KEY / S3_SECRET_KEY sont la clé RACINE (administration) de RustFS. Elle n'est
# remise QU'AU serveur s3 et au conteneur ponctuel `s3-init` (provisionnement) ; jamais à l'API,
# au worker ni au frontend.
S3_ACCESS_KEY=nurselearn
S3_SECRET_KEY=change-me-min-8-chars
# R3 : secrets des trois identités S3 de service, OBLIGATOIRES. 32 à 40 caractères [A-Za-z0-9]
# (limite S3), distincts, jamais versionnés. Ex. : python -c "import secrets;print(secrets.token_hex(16))"
#   S3_API_SECRET_KEY     -> nl-api-uploader  (API : écriture en quarantaine uniquement)
#   S3_SCANNER_SECRET_KEY -> nl-media-scanner (worker : lecture quarantaine, écriture compartiment sain)
#   S3_READER_SECRET_KEY  -> nl-media-reader  (lecture future du compartiment sain ; remis à aucun service)
S3_API_SECRET_KEY=
S3_SCANNER_SECRET_KEY=
S3_READER_SECRET_KEY=
S3_BUCKET_MEDIA=nurselearn-media
# Médias protégés (2.2.3-b) : compartiments PRIVÉS de quarantaine et de fichiers sains.
MEDIA_QUARANTINE_BUCKET=nl-media-quarantine
MEDIA_CLEAN_BUCKET=nl-media-clean
# Analyse antivirus (2.2.3-c, profil Docker « media ») : mot de passe de la connexion PostgreSQL de
# SERVICE nl_media_scanner (non superutilisateur). 32 caractères aléatoires [A-Za-z0-9] au moins,
# jamais versionné. Vide = connexion fermée, worker inutilisable. Ex. : python -c "import secrets;print(secrets.token_hex(24))"
MEDIA_SCANNER_DB_PASSWORD=
# D14 : mot de passe de la connexion PostgreSQL de l'API (rôle nl_api : ni superutilisateur, ni
# propriétaire). OBLIGATOIRE. 32 caractères aléatoires [A-Za-z0-9] au moins, jamais versionné.
# Seul le conteneur `migrate` détient POSTGRES_PASSWORD (administration) ; l'API ne reçoit que celui-ci.
API_DB_PASSWORD=

# Identité et sessions (Phase 2.1, ADR-0007) — sessions opaques côté serveur, pas de JWT
# Clé HMAC des empreintes de jetons : 32 caractères ou plus, OBLIGATOIRE en production
#   (ex. python -c "import secrets; print(secrets.token_urlsafe(48))"). Vide en local : dérivée.
TOKEN_HASH_KEY=
# expiration après inactivité
SESSION_IDLE_TIMEOUT_MINUTES=120
# durée maximale d'une session (7 jours)
SESSION_ABSOLUTE_LIFETIME_HOURS=168
# opérations sensibles : 30 min d'inactivité au plus (décision)
SENSITIVE_IDLE_TIMEOUT_MINUTES=30
# rotation de l'identifiant de session
SESSION_ROTATION_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=72
# true en production (HTTPS)
SESSION_COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000
# déclaratif (ADR-0008) : ne garantit aucune résidence
DATA_REGION=local-dev
# Clé de chiffrement des champs sensibles (32 octets base64)
FIELD_ENCRYPTION_KEY=change-me

# E-mail (Mailpit en local : http://localhost:8025 ; aucun envoi réel sans configuration explicite)
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# IA (Phase 3) — fournisseur configurable, désactivé par défaut
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# Paiements (Phase 6) — AUCUN paiement réel sans configuration explicite
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
