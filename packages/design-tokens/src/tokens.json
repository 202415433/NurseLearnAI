{
  "meta": {
    "name": "NurseLearn AI Design System",
    "version": "0.1.0",
    "wcag_target": "2.2 AA"
  },
  "color": {
    "light": {
      "bg":             "#FFFFFF",
      "surface":        "#F4F7FB",
      "surface-raised": "#FFFFFF",
      "border":         "#D5DEE9",
      "border-strong":  "#7A8BA3",
      "text":           "#0F1E33",
      "text-muted":     "#4A5A70",
      "primary":        "#0B5CAD",
      "primary-hover":  "#094C8F",
      "on-primary":     "#FFFFFF",
      "primary-soft":   "#E3EFFB",
      "accent":         "#0F766E",
      "accent-fill":    "#2CC5B5",
      "on-accent-fill": "#04201F",
      "accent-soft":    "#DDF6F3",
      "success":        "#1A7F37",
      "warning":        "#8A5A00",
      "warning-soft":   "#FFF4D6",
      "danger":         "#B42318",
      "danger-soft":    "#FDE8E6",
      "focus":          "#0B5CAD"
    },
    "dark": {
      "bg":             "#0B1422",
      "surface":        "#111D2E",
      "surface-raised": "#17263B",
      "border":         "#2A3B53",
      "border-strong":  "#6F82A0",
      "text":           "#E8EEF6",
      "text-muted":     "#A9B6C8",
      "primary":        "#6CB2F2",
      "primary-hover":  "#8CC4F6",
      "on-primary":     "#04182E",
      "primary-soft":   "#13304F",
      "accent":         "#3DD9C5",
      "accent-fill":    "#2CC5B5",
      "on-accent-fill": "#04201F",
      "accent-soft":    "#0F3532",
      "success":        "#5BD68A",
      "warning":        "#F2C14E",
      "warning-soft":   "#3A2E0F",
      "danger":         "#FF8A80",
      "danger-soft":    "#3D1714",
      "focus":          "#8CC4F6"
    }
  },
  "contrast_pairs": [
    ["text", "bg", 4.5], ["text", "surface", 4.5], ["text", "surface-raised", 4.5],
    ["text-muted", "bg", 4.5], ["text-muted", "surface", 4.5], ["text-muted", "surface-raised", 4.5],
    ["primary", "bg", 4.5], ["primary", "surface", 4.5],
    ["on-primary", "primary", 4.5], ["on-primary", "primary-hover", 4.5],
    ["primary", "primary-soft", 4.5],
    ["accent", "bg", 4.5], ["accent", "surface", 4.5], ["accent", "accent-soft", 4.5],
    ["on-accent-fill", "accent-fill", 4.5],
    ["success", "bg", 4.5], ["success", "surface", 4.5],
    ["warning", "bg", 4.5], ["warning", "warning-soft", 4.5],
    ["danger", "bg", 4.5], ["danger", "danger-soft", 4.5],
    ["text", "warning-soft", 4.5], ["text", "danger-soft", 4.5],
    ["border-strong", "bg", 3.0], ["border-strong", "surface", 3.0],
    ["focus", "bg", 3.0], ["focus", "surface", 3.0]
  ],
  "font": {
    "family": {
      "sans": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, Roboto, \"Noto Sans\", sans-serif",
      "mono": "\"JetBrains Mono\", \"Cascadia Code\", ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
      "xl": "1.25rem", "2xl": "1.5rem", "3xl": "1.875rem", "4xl": "2.25rem"
    },
    "line-height": { "tight": "1.25", "normal": "1.5", "relaxed": "1.7" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" }
  },
  "space": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem",
    "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 30, 51, 0.08)",
    "md": "0 4px 12px rgba(15, 30, 51, 0.10)",
    "lg": "0 12px 32px rgba(15, 30, 51, 0.14)"
  },
  "motion": {
    "duration-fast": "120ms", "duration-base": "200ms", "duration-slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "size": { "touch-target-min": "44px", "content-max": "72ch", "sidebar": "280px" }
}
