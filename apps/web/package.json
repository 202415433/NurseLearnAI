{
  "name": "@nurselearn/web",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "predev": "npm run sync-tokens",
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync-tokens",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "npm run sync-tokens && tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
